# Copy this file to deploy/.env and fill in real values before running
# `docker compose up` in this directory. See docker-compose.yml's own
# header comment for the full picture of what each variable does and why.

# --- Required, no safe default — the container will refuse to boot without these ---

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Must exactly match manar-api's own MANAR_BFF_SERVICE_TOKEN.
MANAR_BFF_SERVICE_TOKEN=

# --- Have working defaults for a single-host deploy; override for a real one ---

# host.docker.internal:3000 assumes manar-api is running on this same host,
# outside Docker (e.g. `pnpm start:dev`). Point this at manar-api's real
# base URL instead if it's deployed separately.
MANAR_API_BASE_URL=http://host.docker.internal:3000

# The public URL this manar-web deployment is actually reachable at.
APP_BASE_URL=http://localhost:4200

# Host port manar-web's container port 3000 is published on.
MANAR_WEB_HOST_PORT=4200
