NODE_ENV=development

# manar-api's human-facing HTTP API. The BFF auth proxy
# (app/api/bff/[...path]) forwards requests here; the browser never talks
# to this origin directly. Also the source the generated API client's
# codegen script (scripts/generate-api-client.mjs) fetches
# /api/v1/docs-json from.
MANAR_API_BASE_URL=http://localhost:3000

# Keycloak (matches manar-api's deploy/docker-compose.yml host port). As
# of Phase 11b Part 1, manar-web resolves OIDC discovery + the tenant
# client secret through manar-api (MANAR_API_BASE_URL above), not
# Keycloak directly — these KEYCLOAK_ADMIN_* credentials remain only for
# lib/auth/keycloak-admin.ts's still-open ensureRedirectUriRegistered
# gap (see docs/auth-flow.md).
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# Phase 11b Part 1's narrow BFF-service shared secret — must match
# manar-api's own MANAR_BFF_SERVICE_TOKEN exactly. Authenticates
# GET /tenants/:slug/oidc-client-secret; see docs/auth-flow.md.
MANAR_BFF_SERVICE_TOKEN=dev-only-manar-bff-service-token-change-me

# Symmetric key for the encrypted session cookie. Generate a real one with
# `openssl rand -base64 32` for any environment other than a scratch local
# clone — this repo does not ship a working default.
SESSION_SECRET=replace-with-openssl-rand-base64-32-output-min-32-chars

# Public base URL this app is served from (used to build the OIDC
# redirect_uri sent to Keycloak).
APP_BASE_URL=http://localhost:4200
